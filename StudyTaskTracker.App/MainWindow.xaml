<Window x:Class="StudyTaskTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Task Tracker"
        Height="720"
        Width="1050"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Study Task Tracker"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#24324A"/>

                <TextBlock Text="Manage your study tasks and track your progress."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Dashboard -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="4">
                    <StackPanel>
                        <TextBlock Text="Total Tasks"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="TotalCountText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#24324A"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="4">
                    <StackPanel>
                        <TextBlock Text="Completed"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="CompletedCountText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#21875A"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="18"
                        Margin="4">
                    <StackPanel>
                        <TextBlock Text="Pending"
                                   Foreground="#64748B"/>
                        <TextBlock x:Name="PendingCountText"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#B7791F"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Add Task Form -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4,0,4,18">

                <StackPanel>
                    <TextBlock Text="Add New Task"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#24324A"
                               Margin="4,0,4,12"/>

                    <TextBox x:Name="TitleTextBox"
                             ToolTip="Task title"
                             Height="42"/>

                    <TextBox x:Name="SubjectTextBox"
                             ToolTip="Subject"
                             Height="42"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="DueDatePicker"
                                    Grid.Column="0"
                                    Height="40"
                                    Margin="4"/>

                        <ComboBox x:Name="LevelComboBox"
                                  Grid.Column="1"
                                  Height="40"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="High"/>
                        </ComboBox>
                    </Grid>

                    <Button Content="Add Task"
                            HorizontalAlignment="Left"
                            Background="#547FC0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="AddTask_Click"/>
                </StackPanel>
            </Border>

            <!-- Task List -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4">

                <StackPanel>
                    <Grid Margin="4,0,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="My Tasks"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#24324A"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="FilterComboBox"
                                  Grid.Column="1"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterComboBox_SelectionChanged">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Completed"/>
                        </ComboBox>
                    </Grid>

                    <Border Background="#EAF0F8"
                            CornerRadius="8"
                            Padding="12"
                            Margin="4,0,4,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Completion Progress"
                                           FontWeight="SemiBold"
                                           Foreground="#24324A"/>

                                <TextBlock x:Name="ProgressText"
                                           Text="0%"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="#24324A"/>
                            </Grid>

                            <ProgressBar x:Name="ProgressBarControl"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Height="10"
                                         Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EmptyStateText"
                               Text="No tasks yet. Add your first task above."
                               Foreground="#64748B"
                               Margin="8,12"
                               TextAlignment="Center"/>

                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1"
                                        Padding="12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                  Click="TaskCheckBox_Click"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#24324A"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Subject}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       Margin="0,4,0,0"/>

                                            <TextBlock FontSize="12"
                                                       Foreground="#64748B"
                                                       Margin="0,4,0,0">
                                                <Run Text="Due: "/>
                                                <Run Text="{Binding DueDate, StringFormat={}{0:dd MMM yyyy}}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#EAF0F8"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Level}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#425B80"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="4,14,4,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>